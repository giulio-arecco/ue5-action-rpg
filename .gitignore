# Visual Studio user specific files
.vs/

# JetBrains Rider files and folders
.idea/
*.user

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.opendb
*.sdf
*.VC.db
*.VC.opendb
.vsconfig
.vscode

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Third party asset packs
Content/StarterContent/
Content/EuropeanBeech/
Content/StylizedNaturePack/
Content/AnimalVarietyPack/
Content/AncientContent/
Content/Atris_swords

# Quixel Megascans and Fab
Content/Fab/
Content/MSPresets/

# Level and Landscape data
Content/Landscape/
Content/Maps/

# World Partition generated data
Content/__ExternalActors__/
Content/__ExternalObjects__/

# Local development directories
Content/Developers/
Content/Collections/